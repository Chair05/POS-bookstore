{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://tiny-canal-restrict-hiking.trycloudflare.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://tiny-canal-restrict-hiking.trycloudflare.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
