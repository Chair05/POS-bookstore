# Copy to .env and fill in real values. Never commit the filled-in copy.

# ---- HTTP ----
PORT=5000
NODE_ENV=development

# Comma-separated list of browser origins allowed to call this API.
# In production set this to your real storefront/POS origins, e.g.
#   https://shop.example.com,https://pos.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Database ----
# Keep DB_CLIENT unset (or set it to mysql) to use the existing MySQL database.
# For Supabase Postgres, set DB_CLIENT=postgres, DATABASE_URL to the server-side
# connection string, and DB_SSL=true. Never expose DATABASE_URL to a frontend.
# Create a dedicated application user; do NOT run the app as root.
# CREATE USER 'pos_user'@'localhost' IDENTIFIED BY '<strong-password>';
# GRANT ALL PRIVILEGES ON pos_bookstore.* TO 'pos_user'@'localhost';
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pos_bookstore
DB_USER=pos_user
DB_PASSWORD=
# DB_CLIENT=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# DB_SSL=true
# DB_SSL_CA_PATH=C:\certificates\supabase-root.crt
# DB_SSL_CA_CERT=<paste the full PEM certificate as a private deployment variable>

# ---- Supabase Storage (optional; local disk remains the default) ----
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<private server-only service_role key>
# UPLOAD_STORAGE=supabase
# SUPABASE_PRODUCT_BUCKET=product-images
# SUPABASE_RECEIPT_BUCKET=payment-receipts

# ---- Auth ----
# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing this invalidates every issued token.
JWT_SECRET=

# Token lifetimes (any jsonwebtoken duration, e.g. 30m, 12h, 7d).
# Defaults: staff sessions 12h, customer sessions 7d.
# These are overridden per audience if set.
# JWT_EXPIRES_IN=
# JWT_EXPIRES_IN_POS=
# JWT_EXPIRES_IN_ECOM=

# ---- SMTP (optional; verification emails are skipped when unset) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# For Gmail, use an App Password, not the account password.
SMTP_PASS=
